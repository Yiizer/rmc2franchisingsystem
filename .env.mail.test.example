# RMC2 staging real-email settings (phase 1, TEST INBOX ONLY).
# Copy this file to .env.mail.test (gitignored) on this PC and fill it in.
# Read only by scripts/start-staging.ps1 for the staging copy on port 5180.
# NEVER put these keys in .env.local or .env: the real-data dev server (5173) must never get mail
# credentials, and the staging script refuses to start if it finds them there.
# Never paste the filled-in file or the app password into chat, tickets or commits.

RMC2_MAIL_MODE=smtp
# Forced to "staging" by the start script regardless of this value.
RMC2_MAIL_ENV=staging

# Dedicated Gmail account created for testing (not a personal or company mailbox).
RMC2_SMTP_HOST=smtp.gmail.com
RMC2_SMTP_PORT=465
RMC2_SMTP_USER=your-dedicated-test-account@gmail.com
# Google app password (16 characters), requires 2-Step Verification on that account.
RMC2_SMTP_APP_PASSWORD=paste-app-password-here

RMC2_MAIL_FROM_NAME=RMC2 Franchising (Test)
RMC2_MAIL_FROM_ADDRESS=your-dedicated-test-account@gmail.com

# Only these recipients may ever receive mail; every message is redirected to the redirect address.
RMC2_MAIL_ALLOWLIST=product-owner-test-inbox@example.com
RMC2_MAIL_REDIRECT_TO=product-owner-test-inbox@example.com

# 1 = build and log messages but do not send. Set to 0 only for the Product Owner approved live window.
RMC2_MAIL_DRY_RUN=1
# Leave empty. Not used for staging.
RMC2_MAIL_LIVE_CONFIRM=
